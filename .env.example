# =============================================
# 🔧 Cấu hình chung - AI Screenplay
# File .env duy nhất cho cả Node.js và Python API
# Copy file này thành .env và điền thông tin của bạn
# =============================================

# ── OpenRouter AI API ────────────────────────
# Lấy tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
AI_PROVIDER=openrouter

# ── Python API Server ────────────────────────
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=5000
FLASK_DEBUG=True

# ── Cấu hình MySQL ──────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
DB_NAME=ai_screenplay
DB_PORT=3306

# ── Cấu hình PostgreSQL ──────────────────────
PG_HOST=localhost
PG_USER=postgres
PG_PASSWORD=REPLACE_WITH_YOUR_PG_PASSWORD
PG_NAME=ai_screenplay
PG_PORT=5432
DB_TYPE=mysql

# ── Cấu hình Node.js Server ─────────────────
PORT=3000

# ── JWT Secret (dùng cho xác thực) ──────────
# Đặt chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── Cấu hình PayOS ──────────────────────────
PAYOS_CLIENT_ID=REPLACE_WITH_YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=REPLACE_WITH_YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=REPLACE_WITH_YOUR_PAYOS_CHECKSUM_KEY
PAYOS_ENV=sandbox

# ── URL ứng dụng (dùng cho return/cancel URL) 
APP_URL=http://localhost:3000

# ── Cấu hình VNPAY ──────────────────────────
# Đăng ký tại sandbox.vnpayment.vn/devreg
VNPAY_TMN_CODE=REPLACE_WITH_YOUR_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_WITH_YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/return

# ── Cấu hình Email (Nodemailer) ─────────────
# Dùng Gmail App Password (bật 2FA → Tạo App Password tại myaccount.google.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=REPLACE_WITH_YOUR_EMAIL@gmail.com
EMAIL_PASS=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD
EMAIL_FROM=AI Screenplay <REPLACE_WITH_YOUR_EMAIL@gmail.com>
