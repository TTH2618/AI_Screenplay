# Cấu hình MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=REPLACE_WITH_YOUR_DB_PASSWORD
DB_NAME=ai_screenplay
DB_PORT=3306

# Cấu hình Server
PORT=3000

# JWT Secret (dùng cho xác thực) - đặt chuỗi ngẫu nhiên dài ít nhất 32 ký tự
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS

GOOGLE_CLIENT_ID=REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Cấu hình PayOS
PAYOS_CLIENT_ID=REPLACE_WITH_YOUR_PAYOS_CLIENT_ID
PAYOS_API_KEY=REPLACE_WITH_YOUR_PAYOS_API_KEY
PAYOS_CHECKSUM_KEY=REPLACE_WITH_YOUR_PAYOS_CHECKSUM_KEY

# URL ứng dụng (dùng cho return/cancel URL)
APP_URL=http://localhost:3000

# =============================================
# Cấu hình VNPAY (Đăng ký tại sandbox.vnpayment.vn/devreg)
# =============================================
VNPAY_TMN_CODE=REPLACE_WITH_YOUR_TMN_CODE
VNPAY_HASH_SECRET=REPLACE_WITH_YOUR_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/payment/vnpay/return
