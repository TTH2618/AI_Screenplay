<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ExportOptions.plist – Dùng cho workflow ios-deploy.yml (build signed IPA)

  Hướng dẫn chỉnh sửa:
  1. Thay "YOUR_TEAM_ID" bằng Apple Developer Team ID thực của bạn
     (Lấy từ: developer.apple.com → Membership → Team ID)
  2. Thay "com.example.appWebView" bằng Bundle ID thực nếu khác
  3. Thay "YOUR_PROVISIONING_PROFILE_NAME" bằng tên Profile đã tạo trên
     developer.apple.com (App Store Distribution / Ad Hoc)
  4. Đổi "method" thành:
     - "app-store"    → upload TestFlight / App Store
     - "ad-hoc"       → phân phối qua link (không cần Apple account)
     - "development"  → test nội bộ
-->
<plist version="1.0">
<dict>
    <!-- Team ID: Lấy từ developer.apple.com → Membership -->
    <key>teamID</key>
    <string>YOUR_TEAM_ID</string>

    <!-- Phương thức phân phối -->
    <key>method</key>
    <string>app-store</string>

    <!-- Chế độ ký tự động (khuyến nghị cho CI) -->
    <key>signingStyle</key>
    <string>automatic</string>

    <!-- Upload lên App Store Connect sau khi build (chỉ có tác dụng với method=app-store) -->
    <key>uploadBitcode</key>
    <false/>

    <key>uploadSymbols</key>
    <true/>

    <!-- Strip Swift symbols để giảm kích thước -->
    <key>stripSwiftSymbols</key>
    <true/>

    <!-- Đường dẫn output (tương đối với thư mục build) -->
    <key>destination</key>
    <string>export</string>

    <!-- Provisioning profiles: Bundle ID → Tên profile -->
    <!-- Chỉ cần khi signingStyle = manual -->
    <!-- <key>provisioningProfiles</key>
    <dict>
        <key>com.example.appWebView</key>
        <string>YOUR_PROVISIONING_PROFILE_NAME</string>
    </dict> -->
</dict>
</plist>
